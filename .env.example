# Configuración del Servidor HTTP Backend
PORT=3000
NODE_ENV=development

# Proveedor de Modelo de Lenguaje (OpenAI, Anthropic, Google, etc.)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=tu_api_key_aqui_sin_comillas

# Configuración de Sesiones e Iteraciones del Agente
MAX_ITERATIONS=25

# Ruta Raíz de Trabajo (Opcional, por defecto usa la raíz del proyecto)
PROJECT_DIR=.